# 复制为 .env 后按需修改：cp .env.example .env

# 宿主机对外端口（容器内固定 8418）
HTTP_PORT=8080

# 镜像 tag；生产环境建议固定为具体版本，例如 v0.1.0
IMAGE_TAG=latest

# 运行模式 / 日志等级
SERVER_MODE=release
LOG_LEVEL=info

# PostgreSQL（必填密码）。Redis 由 compose 自动启动，仅作可丢弃的统计缓存。
POSTGRES_DATABASE=bridgeops
POSTGRES_USER=bridgeops
POSTGRES_PASSWORD=
REDIS_MAXMEMORY=256mb

# 主密钥（必填，至少 32 字节随机串），用于 AES-GCM 加密渠道密码、Token、API Key 等敏感字段。
# 生成：openssl rand -hex 32
# 修改后既有加密数据将无法解密，请妥善备份。
APP_SECRET=

# 管理员登录（默认开启，ADMIN_PASSWORD 必填）
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 登录会话签名密钥；留空时回退使用 APP_SECRET
AUTH_TOKEN_SECRET=
